state/
reports/
health.json
health.json.tmp
supervisor.log
supervisor.log.*
optimizer.log

# v3 runtime files: panel log, simulation and demo state
panel.log
panel.log.*
state_sim/
state_demo/
simulation.log

# v3.1 runtime files: upgrade backups, migrated config for review, browser smoke output
backups/
config.migrated.json
smoke/
